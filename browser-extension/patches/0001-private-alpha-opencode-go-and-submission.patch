diff --git a/lib/submissionDetector.js b/lib/submissionDetector.js
new file mode 100644
--- /dev/null
+++ b/lib/submissionDetector.js
@@ -0,0 +1,251 @@
+/**
+ * Owner-only submission detector for JobMatch AI.
+ *
+ * Loaded as a normal MV3 content script before content.js. It deliberately uses
+ * the extension's existing MARK_APPLIED / GET_APPLIED_JOBS background messages
+ * and native confirm dialogs so no JobMatch AI UI needs to be rebuilt or patched.
+ */
+(function initSubmissionDetector() {
+  'use strict';
+
+  // manifest.json injects content scripts into all frames. Only the top frame
+  // should ever prompt the user or record application status.
+  if (window !== window.top) return;
+  if (window.__jobmatchSubmissionDetectorLoaded) return;
+  window.__jobmatchSubmissionDetectorLoaded = true;
+
+  const PENDING_KEY = 'jm_pendingSubmission';
+  const PENDING_TTL_MS = 2 * 60 * 1000;
+  const SAME_PAGE_CHECK_MS = 15 * 1000;
+  const SUCCESS_SCAN_INTERVAL_MS = 750;
+
+  const normalizeUrl = (globalThis.JMUrlKey && globalThis.JMUrlKey.normalizeUrlForCache)
+    || (u => String(u || '').split('#')[0]);
+
+  const FINAL_SUBMIT_RE = /^(?:submit(?:\s+(?:my|your|the))?\s+application|submit|send\s+application|complete\s+application|finish\s+application|finish\s+and\s+submit|submit\s+profile)$/i;
+
+  const SUCCESS_TEXT_RE = /(?:thank\s+you\s+for\s+(?:applying|your\s+application)|thanks\s+for\s+(?:applying|your\s+application)|application\s+(?:successfully\s+)?submitted|application\s+has\s+been\s+submitted|we\s+(?:have\s+)?received\s+your\s+application|application\s+received|your\s+application\s+is\s+complete|application\s+complete|submission\s+received)/i;
+
+  const SUCCESS_URL_RE = /(?:thank[-_]?you|application[-_/]?(?:complete|submitted|success)|\/submitted(?:[/?#]|$)|\/confirmation(?:[/?#]|$))/i;
+
+  let samePageTimer = null;
+  let successPoll = null;
+  let promptInFlight = false;
+
+  function runtimeMessage(message) {
+    return new Promise((resolve, reject) => {
+      chrome.runtime.sendMessage(message, (response) => {
+        if (chrome.runtime.lastError) {
+          reject(new Error(chrome.runtime.lastError.message));
+          return;
+        }
+        if (!response) {
+          reject(new Error('No response from JobMatch AI background service'));
+          return;
+        }
+        if (response.success === false) {
+          reject(new Error(response.error || 'JobMatch AI background request failed'));
+          return;
+        }
+        resolve(response.data);
+      });
+    });
+  }
+
+  function getButtonLabel(target) {
+    const button = target && target.closest
+      ? target.closest('button, input[type="submit"], [role="button"]')
+      : null;
+    if (!button) return '';
+
+    const candidates = [
+      button.innerText,
+      button.value,
+      button.getAttribute('aria-label'),
+      button.getAttribute('title'),
+    ];
+
+    return candidates
+      .map(v => String(v || '').replace(/\s+/g, ' ').trim())
+      .find(Boolean) || '';
+  }
+
+  function looksLikeFinalSubmit(label) {
+    return FINAL_SUBMIT_RE.test(String(label || '').replace(/\s+/g, ' ').trim());
+  }
+
+  function hasSuccessSignal() {
+    if (SUCCESS_URL_RE.test(window.location.href)) return true;
+    const text = String(document.body?.innerText || '');
+    // The end of the page usually contains the ATS completion state and keeps
+    // the repeated scan cheap on very long application pages.
+    const bounded = text.length > 30000 ? text.slice(-30000) : text;
+    return SUCCESS_TEXT_RE.test(bounded);
+  }
+
+  function extractFallbackMeta() {
+    const firstText = (selectors) => {
+      for (const selector of selectors) {
+        const el = document.querySelector(selector);
+        const text = String(el?.innerText || el?.textContent || '').replace(/\s+/g, ' ').trim();
+        if (text) return text;
+      }
+      return '';
+    };
+
+    const title = firstText([
+      '[data-automation-id="jobTitle"]',
+      '.jobs-unified-top-card__job-title',
+      '.posting-headline h2',
+      'h1',
+    ]) || document.title.split('|')[0].split(' - ')[0].trim();
+
+    const company = firstText([
+      '[data-automation-id="company"]',
+      '.jobs-unified-top-card__company-name',
+      '.posting-headline h3',
+      '[class*="company-name"]',
+      '[class*="companyName"]',
+    ]);
+
+    return {
+      title,
+      company,
+      location: '',
+      salary: '',
+      score: 0,
+      url: normalizeUrl(window.location.href),
+    };
+  }
+
+  async function writePending(pending) {
+    try {
+      await chrome.storage.session.set({ [PENDING_KEY]: pending });
+    } catch (_) {
+      // storage.session is available on supported Chromium MV3 builds, but a
+      // failed write should never interfere with the ATS page's own submit.
+    }
+  }
+
+  async function readPending() {
+    try {
+      const result = await chrome.storage.session.get(PENDING_KEY);
+      const pending = result[PENDING_KEY];
+      if (!pending || !pending.startedAt) return null;
+      if (Date.now() - pending.startedAt > PENDING_TTL_MS) {
+        await clearPending();
+        return null;
+      }
+      return pending;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  async function clearPending() {
+    try { await chrome.storage.session.remove(PENDING_KEY); } catch (_) { /* ignore */ }
+  }
+
+  async function isAlreadyApplied(url) {
+    try {
+      const jobs = await runtimeMessage({ type: 'GET_APPLIED_JOBS' });
+      const key = normalizeUrl(url);
+      return Array.isArray(jobs) && jobs.some(job => normalizeUrl(job?.url) === key);
+    } catch (_) {
+      return false;
+    }
+  }
+
+  async function markApplied(pending) {
+    const meta = pending?.jobData || extractFallbackMeta();
+    const originalUrl = pending?.originalUrl || meta.url || window.location.href;
+    const jobData = {
+      title: meta.title || document.title || 'Application',
+      company: meta.company || '',
+      location: meta.location || '',
+      salary: meta.salary || '',
+      score: Number(meta.score || 0),
+      url: normalizeUrl(originalUrl),
+    };
+
+    if (await isAlreadyApplied(jobData.url)) {
+      await clearPending();
+      return;
+    }
+
+    await runtimeMessage({ type: 'MARK_APPLIED', jobData });
+    await clearPending();
+    window.alert('Application marked as Applied in JobMatch AI.');
+  }
+
+  async function confirmAndRecord(pending, detected) {
+    if (promptInFlight) return;
+    promptInFlight = true;
+    try {
+      const message = detected
+        ? 'This application appears to have been submitted successfully. Mark it as Applied?'
+        : 'Did this application submit successfully?';
+      if (window.confirm(message)) {
+        await markApplied(pending);
+      } else {
+        await clearPending();
+      }
+    } catch (err) {
+      console.warn('[JobMatch AI] Could not record submitted application:', err);
+    } finally {
+      promptInFlight = false;
+    }
+  }
+
+  function stopSamePageWatch() {
+    if (samePageTimer) clearTimeout(samePageTimer);
+    if (successPoll) clearInterval(successPoll);
+    samePageTimer = null;
+    successPoll = null;
+  }
+
+  function startSamePageWatch(pending) {
+    stopSamePageWatch();
+
+    successPoll = setInterval(async () => {
+      if (!hasSuccessSignal()) return;
+      stopSamePageWatch();
+      await confirmAndRecord(pending, true);
+    }, SUCCESS_SCAN_INTERVAL_MS);
+
+    samePageTimer = setTimeout(async () => {
+      stopSamePageWatch();
+      const stillPending = await readPending();
+      if (stillPending) await confirmAndRecord(stillPending, false);
+    }, SAME_PAGE_CHECK_MS);
+  }
+
+  async function onPossibleSubmit(label) {
+    const pending = {
+      startedAt: Date.now(),
+      originalUrl: normalizeUrl(window.location.href),
+      submitLabel: label,
+      jobData: extractFallbackMeta(),
+    };
+
+    await writePending(pending);
+    startSamePageWatch(pending);
+  }
+
+  document.addEventListener('click', (event) => {
+    const label = getButtonLabel(event.target);
+    if (!looksLikeFinalSubmit(label)) return;
+    // Capture-phase listener runs before most ATS handlers. Do not prevent,
+    // stop, await, or otherwise interfere with the application's own click.
+    void onPossibleSubmit(label);
+  }, true);
+
+  // If a final-submit click caused a real navigation, this fresh content script
+  // can complete detection on a known thank-you/confirmation page.
+  void (async () => {
+    const pending = await readPending();
+    if (pending && hasSuccessSignal()) {
+      await confirmAndRecord(pending, true);
+    }
+  })();
+})();
