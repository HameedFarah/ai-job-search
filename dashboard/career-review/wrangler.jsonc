{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-engine-private",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site"
  },
  "routes": [
    {
      "pattern": "career.farahdigital.com/*",
      "zone_name": "farahdigital.com"
    }
  ]
}
